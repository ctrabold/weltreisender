{
  "markdown": {
    "codeBlock.preserveIndentation": true,
    "heading.kind": "atx",
    "list.unorderedMarker": "dashes"
  },
  "toml": {
    "quoteStyle": "preferSingle"
  },
  "excludes": [
    "assets/images",
    "data/**",
    "layouts/**",
    "public/",
    "resources",
    "themes/**"
  ],
  "plugins": [
    "npm:@dprint/dockerfile@0.8.0",
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "npm:@dprint/shfmt@0.2.0",
    "npm:@dprint/toml@0.10.0",
    "npm:@dprint/oxc@0.51.0"
  ]
}
